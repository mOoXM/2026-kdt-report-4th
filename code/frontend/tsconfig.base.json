{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    // paths 는 baseUrl 없이 이 파일 위치 기준으로 푼다 (TS 6 에서 baseUrl 은 폐기)
    "paths": { "@pl/shared": ["./packages/shared/src/index.ts"], "@pl/shared/*": ["./packages/shared/src/*"] }
  }
}
